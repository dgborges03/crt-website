---
import Layout from "../../layouts/Layout.astro";

const posts = [
  { title: "Combat Robotics: 1lb & 3lb bots are in progress", date: "Dec 2025", slug: "combat-robotics-1lb-3lb", image: "/blog/placeholder-combat.jpg" },
  { title: "CCBR Quadruped collaboration continues", date: "Dec 2025", slug: "ccbr-quadruped-collaboration", image: "/blog/placeholder-quadruped.jpg" },
  { title: "VTOL Drone / UAV: airframe + autonomy roadmap", date: "Coming Soon", slug: "vtol-uav-roadmap", image: "/blog/placeholder-uav.jpg" },
  { title: "RoboSub: underwater autonomy + sensing experiments", date: "Coming Soon", slug: "robosub-autonomy-sensing", image: "/blog/placeholder-robosub.jpg" },
];
---

<Layout>
  <section class="border-b border-white/5 bg-zinc-950/60">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <h1 class="font-display text-2xl sm:text-4xl text-orange-400">Blog</h1>
      <p class="mt-3 max-w-3xl text-zinc-300">News, updates, and progress from CRT.</p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {posts.map((p) => (
        <a href={`/blog/${p.slug}`} class="group rounded-2xl border border-white/10 bg-zinc-900/50 shadow-lg overflow-hidden hover:bg-white/5 transition">
          <div class="h-44 w-full bg-zinc-950/40">
            <img src={p.image} alt={p.title} class="h-full w-full object-cover opacity-90 group-hover:opacity-100 transition" loading="lazy" decoding="async" />
          </div>
          <div class="p-6">
            <p class="text-xs text-zinc-400">{p.date}</p>
            <h2 class="mt-2 font-display text-orange-400 text-lg">{p.title}</h2>
            <div class="mt-5 inline-flex items-center gap-2 text-sm text-zinc-200">
              Read more
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M7 7h10v10" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
