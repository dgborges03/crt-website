<script is:inline>
  const slides = Array.from(document.querySelectorAll('[data-hero]'));
  let i = 0;

  // Time for how long each img stays on screen
  const intervalMs = 10000;

  // fade helper
  function show(idx) {
    slides.forEach((el, j) => {
      el.classList.toggle('opacity-100', j === idx);
      el.classList.toggle('opacity-0', j !== idx);
    });
  }

  // start
  show(i);

  // cycle
  setInterval(() => {
    i = (i + 1) % slides.length;
    show(i);
  }, intervalMs);
</script>

